@model IReadOnlyList<OrderListItemViewModel>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var selectedStatus = ViewBag.Status as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Quản lý đơn hàng</h1>
        <p class="text-muted mb-0">Xác nhận và cập nhật tiến độ xử lý đơn.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-5 col-md-4">
        <label for="status" class="form-label">Trạng thái</label>
        <select id="status" name="status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in OrderWorkflowHelper.OrderStatuses)
            {
                <option value="@status" selected="@(status == selectedStatus)">
                    @OrderWorkflowHelper.OrderStatusLabel(status)
                </option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary" type="submit">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Không có đơn hàng phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Thời gian</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">@order.OrderCode</td>
                        <td>@order.CustomerName</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div>@OrderWorkflowHelper.PaymentMethodLabel(order.PaymentMethod)</div>
                            <div class="small text-muted">
                                @OrderWorkflowHelper.PaymentStatusLabel(order.PaymentStatus)
                            </div>
                        </td>
                        <td>
                            <span class="badge @OrderWorkflowHelper.StatusBadgeClass(order.Status)">
                                @OrderWorkflowHelper.OrderStatusLabel(order.Status)
                            </span>
                        </td>
                        <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.OrderId"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
