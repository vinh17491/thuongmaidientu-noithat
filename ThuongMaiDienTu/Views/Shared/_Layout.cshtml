<!DOCTYPE html>
<html lang="vi">
<head>
    @{ var path = Context.Request.Path.Value ?? string.Empty; var privatePath = path.StartsWith("/Account", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Seller", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Carrier", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Cart", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Checkout", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Orders", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/ProductAdmin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/OrderAdmin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/ReviewAdmin", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Dashboard", StringComparison.OrdinalIgnoreCase); }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nội Thất Hub</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Marketplace nội thất và đồ gia dụng đa gian hàng.")" />
    @if (ViewData["CanonicalPath"] is string canonicalPath) { <link rel="canonical" href="@canonicalPath" /> }
    @if (ViewData["Robots"] is string robots) { <meta name="robots" content="@robots" /> }
    @if (ViewData["Robots"] is not string && privatePath) { <meta name="robots" content="noindex,nofollow" /> }
    @await RenderSectionAsync("Meta", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ThuongMaiDienTu.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Nội Thất Hub</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Products"
                               asp-action="Index">
                                Sản phẩm
                            </a>
                        </li>
                        @if (User.IsInRole("ADMIN") || User.IsInRole("SELLER"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Quản trị
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="ProductAdmin"
                                           asp-action="Index">Quản lý sản phẩm</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="ProductCategories"
                                           asp-action="Index">Quản lý danh mục</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="OrderAdmin"
                                           asp-action="Index">Quản lý đơn hàng</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="ReviewAdmin"
                                           asp-action="Index">Quản lý đánh giá</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Dashboard"
                                           asp-action="Index">Dashboard</a>
                                    </li>
                                    @if (User.IsInRole("SELLER"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="SellerStores" asp-action="Index">Gian hàng của tôi</a></li>
                                    }
                                    @if (User.IsInRole("ADMIN"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="AdminStores" asp-action="Index">Duyệt gian hàng</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("CARRIER") || User.IsInRole("ADMIN"))
                            {
                                <li class="nav-item"><a class="nav-link text-dark" asp-controller="CarrierPortal" asp-action="Index">Carrier Portal</a></li>
                            }
                            @if (User.IsInRole("CUSTOMER"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="nav-link">Xin chào, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Nội Thất Hub · Marketplace nội thất và gia dụng đa gian hàng
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <button id="chatToggle" type="button" class="chat-toggle" aria-label="Mở trợ lý mua sắm">💬</button>
    <section id="chatbox" class="chatbox shadow" hidden aria-label="Trợ lý mua sắm Nội Thất Hub">
        <header class="chatbox-header">Trợ lý mua sắm Nội Thất Hub <button id="chatClose" type="button" aria-label="Đóng">×</button></header>
        <div id="chatMessages" class="chat-messages"></div>
        <form id="chatForm">@Html.AntiForgeryToken()<input id="chatInput" maxlength="500" required placeholder="Bạn cần tìm gì?" autocomplete="off" /><button type="submit">Gửi</button></form>
    </section>
    <script>
    (() => { const box=document.getElementById('chatbox'),toggle=document.getElementById('chatToggle'),close=document.getElementById('chatClose'),messages=document.getElementById('chatMessages'),form=document.getElementById('chatForm'),input=document.getElementById('chatInput'); if(!box||!form)return; const add=(text,who)=>{const p=document.createElement('p');p.className=who;p.textContent=text;messages.appendChild(p);messages.scrollTop=messages.scrollHeight;}; toggle.onclick=()=>box.hidden=false; close.onclick=()=>box.hidden=true; form.onsubmit=async e=>{e.preventDefault();const message=input.value.trim();if(!message)return;add(message,'user');input.value='';form.querySelector('button').disabled=true;try{const r=await fetch('/tro-ly/hoi',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message})});const data=await r.json();add(data.message??'Trợ lý tạm thời không khả dụng.','assistant');}catch{add('Trợ lý tạm thời không khả dụng.','assistant');}finally{form.querySelector('button').disabled=false;}}; })();
    </script>
</body>
</html>
