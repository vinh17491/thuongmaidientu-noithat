@model ThuongMaiDienTu.ViewModels.ProductAdminFormViewModel

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="mb-3">
    <h1 class="h3">Sửa sản phẩm</h1>
    <p class="text-muted">Cập nhật sản phẩm, SKU, giá, tồn kho và ảnh chính.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-outline-info">Chi tiết</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
