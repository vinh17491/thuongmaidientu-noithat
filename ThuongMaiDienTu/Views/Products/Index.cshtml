@model ThuongMaiDienTu.ViewModels.ProductCatalogViewModel

@{
    ViewData["Title"] = "Cửa hàng đồ gia dụng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Cửa hàng đồ gia dụng</h1>
        <p class="text-muted mb-0">Sản phẩm đang mở bán tại Gia Dụng Việt.</p>
    </div>
</div>

<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-7">
            <label asp-for="SearchTerm" class="form-label">Tìm sản phẩm</label>
            <input asp-for="SearchTerm" class="form-control"
                   placeholder="Tên sản phẩm, thương hiệu hoặc mã SKU..." />
        </div>
        <div class="col-md-3">
            <label asp-for="CategoryId" class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">Tất cả danh mục</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">Xóa</a>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">
        <h2 class="h5">Không tìm thấy sản phẩm</h2>
        <p>Không có sản phẩm phù hợp với từ khóa hoặc danh mục đã chọn.</p>
        <a asp-action="Index" class="btn btn-outline-primary">Xem tất cả sản phẩm</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <article class="card product-card h-100 shadow-sm">
                    <div class="product-image-wrap">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 alt="@(item.AltText ?? item.ProductName)"
                                 class="card-img-top product-card-image"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="product-image-placeholder align-items-center justify-content-center text-muted"
                                 style="display:none;">Không có ảnh</div>
                        }
                        else
                        {
                            <div class="product-image-placeholder d-flex align-items-center justify-content-center text-muted">
                                Chưa có ảnh
                            </div>
                        }

                        @if (item.IsOnSale)
                        {
                            <span class="badge bg-danger product-discount-badge">
                                -@item.DiscountPercent%
                            </span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-light text-dark border">@item.CategoryName</span>
                            @if (item.IsInStock)
                            {
                                <span class="badge bg-success">Còn hàng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Hết hàng</span>
                            }
                        </div>

                        <h2 class="h5 card-title">@item.ProductName</h2>

                        @if (!string.IsNullOrWhiteSpace(item.Brand))
                        {
                            <div class="small text-muted mb-2">Thương hiệu: @item.Brand</div>
                        }

                        <p class="card-text text-muted product-description">
                            @(item.ShortDescription ?? "Thông tin sản phẩm đang được cập nhật.")
                        </p>

                        <div class="mt-auto">
                            @if (item.IsOnSale)
                            {
                                <div class="text-muted text-decoration-line-through">
                                    @item.Price.ToString("N0") đ
                                </div>
                                <div class="product-current-price text-danger">
                                    @item.CurrentPrice.ToString("N0") đ
                                </div>
                            }
                            else
                            {
                                <div class="product-current-price">
                                    @item.CurrentPrice.ToString("N0") đ
                                </div>
                            }

                            <a asp-action="Details" asp-route-id="@item.ProductId"
                               class="btn btn-outline-primary w-100 mt-3">Xem chi tiết</a>

                            @if (User.IsInRole("CUSTOMER"))
                            {
                                @if (item.IsInStock)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-2">
                                        <input type="hidden" name="SkuId" value="@item.SkuId" />
                                        <input type="hidden" name="Quantity" value="1" />
                                        <button type="submit" class="btn btn-primary w-100">
                                            Thêm vào giỏ
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary w-100 mt-2" disabled>
                                        Hết hàng
                                    </button>
                                }
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login"
                                   asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                                   class="btn btn-link w-100 mt-2">Đăng nhập để mua</a>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
