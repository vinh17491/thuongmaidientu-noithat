@model ThuongMaiDienTu.ViewModels.ProductCatalogViewModel
@using System.Text.Json
@{
    var isCategoryPage = ViewData["BreadcrumbName"] is string && ViewData["BreadcrumbPath"] is string;
    var breadcrumbJson = isCategoryPage
        ? JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new[]
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang chủ", ["item"] = "/" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = ViewData["BreadcrumbName"], ["item"] = ViewData["BreadcrumbPath"] }
            }
        })
        : null;
}
@{ if (ViewData["CanonicalPath"] is null) { ViewData["CanonicalPath"] = "/san-pham"; } if (ViewData["Robots"] is null) { ViewData["Robots"] = Context.Request.Query.Count > 0 ? "noindex,follow" : "index,follow"; } }
@{
    var pageTitle = ViewData["Title"] as string ?? "Cửa hàng đồ gia dụng";
    var pageDescription = ViewData["Description"] as string ?? "Khám phá sản phẩm đang mở bán trên toàn marketplace.";
    var canonicalPath = ViewData["CanonicalPath"] as string ?? "/san-pham";
}
@section Meta {
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalPath" />
    @if (breadcrumbJson is not null)
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbJson)</script>
    }
}
@{ ViewData["Title"] = pageTitle; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">@pageTitle</h1><p class="text-muted">@pageDescription</p></div><span class="text-muted">@Model.TotalItems kết quả</span></div>
<form method="get" class="card card-body shadow-sm mb-4"><div class="row g-3 align-items-end">
<div class="col-md-6"><label class="form-label" for="SearchTerm">Tìm sản phẩm</label><input id="SearchTerm" name="SearchTerm" value="@Model.SearchTerm" maxlength="100" class="form-control" placeholder="Tên, mô tả, thương hiệu hoặc gian hàng" /></div>
<div class="col-md-3"><label class="form-label" for="CategoryId">Danh mục</label><select id="CategoryId" name="CategoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach (var item in Model.Categories) { <option value="@item.Value" selected="@(item.Value == Model.CategoryId?.ToString() ? "selected" : null)">@item.Text</option> }</select></div>
<div class="col-md-3"><label class="form-label" for="StoreId">Gian hàng</label><select id="StoreId" name="StoreId" class="form-select"><option value="">Tất cả gian hàng</option>@foreach (var item in Model.Stores) { <option value="@item.Value" selected="@(item.Value == Model.StoreId?.ToString() ? "selected" : null)">@item.Text</option> }</select></div>
<div class="col-md-3"><label class="form-label" for="Brand">Thương hiệu</label><select id="Brand" name="Brand" class="form-select"><option value="">Tất cả thương hiệu</option>@foreach (var item in Model.Brands) { <option value="@item.Value" selected="@(item.Value == Model.Brand ? "selected" : null)">@item.Text</option> }</select></div>
<div class="col-md-2"><label class="form-label" for="MinPrice">Giá từ</label><input id="MinPrice" name="MinPrice" value="@Model.MinPrice" type="number" min="0" class="form-control" /></div><div class="col-md-2"><label class="form-label" for="MaxPrice">Giá đến</label><input id="MaxPrice" name="MaxPrice" value="@Model.MaxPrice" type="number" min="0" class="form-control" /></div>
<div class="col-md-2"><label class="form-label" for="MinimumRating">Đánh giá tối thiểu</label><select id="MinimumRating" name="MinimumRating" class="form-select"><option value="">Tất cả</option>@for (var rating = 5; rating >= 1; rating--) { <option value="@rating" selected="@(Model.MinimumRating == rating ? "selected" : null)">Từ @rating sao</option> }</select></div>
<div class="col-md-3"><label class="form-label" for="Sort">Sắp xếp</label><select id="Sort" name="Sort" class="form-select"><option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Mới nhất</option><option value="price_asc" selected="@(Model.Sort == "price_asc" ? "selected" : null)">Giá tăng</option><option value="price_desc" selected="@(Model.Sort == "price_desc" ? "selected" : null)">Giá giảm</option><option value="rating_desc" selected="@(Model.Sort == "rating_desc" ? "selected" : null)">Rating cao</option><option value="name_asc" selected="@(Model.Sort == "name_asc" ? "selected" : null)">Tên A-Z</option></select></div>
<div class="col-auto form-check"><input id="InStockOnly" name="InStockOnly" value="true" @(Model.InStockOnly ? "checked" : null) class="form-check-input" type="checkbox" /><label class="form-check-label" for="InStockOnly">Còn hàng</label></div><div class="col-auto form-check"><input id="OnSaleOnly" name="OnSaleOnly" value="true" @(Model.OnSaleOnly ? "checked" : null) class="form-check-input" type="checkbox" /><label class="form-check-label" for="OnSaleOnly">Đang khuyến mãi</label></div><div class="col-auto"><button class="btn btn-primary">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a></div></div></form>
@if (Model.Items.Count == 0) { <div class="alert alert-info">Không tìm thấy sản phẩm phù hợp.</div> } else { <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">@foreach (var item in Model.Items) { <div class="col"><article class="card product-card h-100 shadow-sm"><div class="product-image-wrap">@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@(item.AltText ?? item.ProductName)" class="card-img-top product-card-image" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" /><div class="product-image-placeholder d-flex align-items-center justify-content-center text-muted" hidden>Không tải được ảnh</div> } else { <div class="product-image-placeholder d-flex align-items-center justify-content-center text-muted">Chưa có ảnh</div> } </div><div class="card-body d-flex flex-column"><div><span class="badge bg-light text-dark border">@item.CategoryName</span> <span class="badge bg-light text-dark border">@item.StoreName</span></div><h2 class="h5 mt-2">@item.ProductName</h2>@if (!string.IsNullOrWhiteSpace(item.Brand)) { <div class="small text-muted">@item.Brand</div> }<div class="small text-muted">★ @item.AverageRating.ToString("0.0") (@item.ReviewCount) · @(item.IsInStock ? "Còn hàng" : "Hết hàng")</div><div class="mt-auto">@if (item.IsOnSale) { <div class="text-muted text-decoration-line-through">@item.Price.ToString("N0") đ</div> }<div class="product-current-price @(item.IsOnSale ? "text-danger" : null)">@item.CurrentPrice.ToString("N0") đ</div><a asp-action="CanonicalDetails" asp-route-productSlug="@item.Slug" class="btn btn-outline-primary w-100 mt-3">Xem chi tiết</a></div></div></article></div> }</div> }
<nav class="d-flex justify-content-between align-items-center mt-4" aria-label="Phân trang"><span>Trang @Model.Page/@Model.TotalPages</span><span class="d-flex gap-2">@if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-route-page="@(Model.Page - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-storeId="@Model.StoreId" asp-route-brand="@Model.Brand" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-minimumRating="@Model.MinimumRating" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-sort="@Model.Sort">Trước</a> } @if (Model.Page < Model.TotalPages) { <a class="btn btn-outline-secondary" asp-route-page="@(Model.Page + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-storeId="@Model.StoreId" asp-route-brand="@Model.Brand" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-minimumRating="@Model.MinimumRating" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-sort="@Model.Sort">Sau</a> }</span></nav>
