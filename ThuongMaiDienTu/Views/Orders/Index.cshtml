@model IReadOnlyList<OrderListItemViewModel>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Đơn hàng của tôi</h1>
        <p class="text-muted mb-0">Theo dõi các đơn đã đặt bằng tài khoản này.</p>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
        Tiếp tục mua hàng
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Bạn chưa có đơn hàng nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt</th>
                    <th>Số lượng</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">@order.OrderCode</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.TotalQuantity</td>
                        <td>@OrderWorkflowHelper.PaymentMethodLabel(order.PaymentMethod)</td>
                        <td>
                            <span class="badge @OrderWorkflowHelper.StatusBadgeClass(order.Status)">
                                @OrderWorkflowHelper.OrderStatusLabel(order.Status)
                            </span>
                        </td>
                        <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@order.OrderId"
                               class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
