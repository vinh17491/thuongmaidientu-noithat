@model ThuongMaiDienTu.ViewModels.AdminStoreIndexViewModel
@{ ViewData["Title"] = "Duyệt gian hàng"; }
<h1>Duyệt gian hàng</h1>
<form method="get" class="row g-2 mb-3"><div class="col"><input name="search" value="@Model.Search" class="form-control" placeholder="Tên gian hàng hoặc email seller" /></div><div class="col-auto"><select name="status" class="form-select"><option value="">Tất cả trạng thái</option>@foreach (var s in new[] { "PENDING", "ACTIVE", "REJECTED", "SUSPENDED" }) { <option selected="@(Model.Status == s)" value="@s">@s</option> }</select></div><div class="col-auto"><button class="btn btn-outline-secondary">Lọc</button></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Gian hàng</th><th>Seller</th><th>Trạng thái</th><th>Sản phẩm</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@item.StoreId">@item.StoreName</a></td><td>@item.SellerName<br /><small>@item.SellerEmail</small></td><td>@item.Status</td><td>@item.ProductCount</td><td><form asp-action="ChangeStatus" method="post" class="d-flex gap-1"><input type="hidden" name="StoreId" value="@item.StoreId" /><select name="NextStatus" class="form-select form-select-sm"><option>ACTIVE</option><option>REJECTED</option><option>SUSPENDED</option><option>PENDING</option></select><input name="Reason" required maxlength="500" class="form-control form-control-sm" placeholder="Lý do" /><button class="btn btn-sm btn-primary">Lưu</button></form></td></tr> }
</tbody></table></div>
<div class="d-flex gap-2"><span>Trang @Model.Page</span>@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Trước</a> }@if (Model.HasNextPage) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Sau</a> }</div>
