@model ThuongMaiDienTu.ViewModels.ProductAdminFormViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="mb-3">
    <h1 class="h3">Thêm sản phẩm</h1>
    <p class="text-muted">Tạo đồng thời sản phẩm, một SKU và ảnh chính bằng URL hoặc file từ máy.</p>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu sản phẩm</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
