@model ThuongMaiDienTu.ViewModels.ProductAdminIndexViewModel

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Quản lý sản phẩm</h1>
        <p class="text-muted mb-0">Quản lý thông tin hàng bán, SKU, giá và tồn kho.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm sản phẩm</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label asp-for="SearchTerm" class="form-label">Tên sản phẩm hoặc mã SKU</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Nhập từ khóa..." />
        </div>
        <div class="col-lg-3">
            <label asp-for="CategoryId" class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">Tất cả danh mục</option>
            </select>
        </div>
        <div class="col-lg-3">
            <label asp-for="Status" class="form-label">Trạng thái</label>
            <select asp-for="Status" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="ACTIVE">Đang bán</option>
                <option value="HIDDEN">Đang ẩn</option>
                <option value="DRAFT">Bản nháp</option>
            </select>
        </div>
        <div class="col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">Không tìm thấy sản phẩm phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Mã</th>
                    <th>Sản phẩm</th>
                    <th>Danh mục / Cửa hàng</th>
                    <th>SKU</th>
                    <th class="text-end">Giá và khuyến mãi</th>
                    <th class="text-end">Tồn kho</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th style="min-width: 210px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td style="width: 76px;">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.ProductName"
                                     class="img-thumbnail"
                                     style="width: 60px; height: 60px; object-fit: cover;"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <span class="border rounded bg-light text-muted align-items-center justify-content-center"
                                      style="display:none; width:60px; height:60px; font-size:11px;">Không ảnh</span>
                            }
                            else
                            {
                                <span class="border rounded bg-light text-muted d-flex align-items-center justify-content-center"
                                      style="width:60px; height:60px; font-size:11px;">Không ảnh</span>
                            }
                        </td>
                        <td>@item.ProductId</td>
                        <td><strong>@item.ProductName</strong></td>
                        <td>
                            <div>@item.CategoryName</div>
                            <small class="text-muted">@item.StoreName</small>
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(item.SkuCode))
                            {
                                <span class="text-danger">Thiếu SKU</span>
                            }
                            else
                            {
                                <code>@item.SkuCode</code>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (item.Price.HasValue)
                            {
                                <div>Giá thường: @item.Price.Value.ToString("N0") đ</div>
                                @if (item.SalePrice.HasValue)
                                {
                                    <div class="small text-danger">
                                        Giá KM: @item.SalePrice.Value.ToString("N0") đ
                                    </div>
                                }
                                <div class="fw-semibold">
                                    Hiện hành: @item.CurrentPrice?.ToString("N0") đ
                                </div>
                                <span class="badge @(item.PromotionStatus == "Đang khuyến mãi" ? "bg-danger" : item.PromotionStatus == "Sắp diễn ra" ? "bg-info text-dark" : item.PromotionStatus == "Đã kết thúc" ? "bg-secondary" : "bg-light text-dark border")">
                                    @item.PromotionStatus
                                </span>
                                @if (item.SaleStart.HasValue || item.SaleEnd.HasValue)
                                {
                                    <div class="small text-muted mt-1">
                                        @(item.SaleStart?.ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")
                                        —
                                        @(item.SaleEnd?.ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-danger">Chưa có giá</span>
                            }
                        </td>
                        <td class="text-end">
                            @(item.StockQuantity?.ToString("N0") ?? "—")
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case "ACTIVE":
                                    <span class="badge bg-success">Đang bán</span>
                                    break;
                                case "HIDDEN":
                                    <span class="badge bg-secondary">Đang ẩn</span>
                                    break;
                                case "DRAFT":
                                    <span class="badge bg-warning text-dark">Bản nháp</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark">@item.Status</span>
                                    break;
                            }
                        </td>
                        <td class="text-nowrap">@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Details" asp-route-id="@item.ProductId"
                                   class="btn btn-sm btn-outline-info">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.ProductId"
                                   class="btn btn-sm btn-outline-warning">Sửa</a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.ProductId"
                                      method="post" class="d-inline">
                                    <button type="submit"
                                            class="btn btn-sm @(item.Status == "ACTIVE" ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(item.Status == "ACTIVE" ? "Ẩn" : "Mở bán")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
