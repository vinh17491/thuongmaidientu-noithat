@model ThuongMaiDienTu.ViewModels.ProductCatalogViewModel
@using System.Text.Json
@{
    var pageTitle = ViewData["Title"] as string ?? "Siêu thị sản phẩm";
    var pageDescription = ViewData["Description"] as string ?? "Khám phá sản phẩm đang mở bán trên toàn siêu thị.";
    ViewData["Title"] = pageTitle;
    ViewData["CanonicalPath"] ??= "/san-pham";
    ViewData["Robots"] ??= Context.Request.Query.Count > 0 ? "noindex,follow" : "index,follow";
    var isCategoryPage = ViewData["BreadcrumbName"] is string && ViewData["BreadcrumbPath"] is string;
    var breadcrumbJson = isCategoryPage ? JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org", ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang chủ", ["item"] = "/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = ViewData["BreadcrumbName"], ["item"] = ViewData["BreadcrumbPath"] }
        }
    }) : null;
}

@section Meta {
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@ViewData["CanonicalPath"]" />
    @if (breadcrumbJson is not null) { <script type="application/ld+json">@Html.Raw(breadcrumbJson)</script> }
}

<header class="catalog-header mb-4">
    <div><span class="section-kicker">ĐI CHỢ ONLINE</span><h1>@pageTitle</h1><p>@pageDescription</p></div>
    <div class="catalog-count"><strong>@Model.TotalItems</strong><span>sản phẩm</span></div>
</header>

<form method="get" class="card catalog-filter mb-4">
    <div class="card-body"><div class="row g-3 align-items-end">
        <div class="col-lg-5"><label class="form-label" for="SearchTerm">Bạn đang tìm gì?</label><input id="SearchTerm" name="SearchTerm" value="@Model.SearchTerm" maxlength="100" class="form-control" placeholder="Tên sản phẩm, thương hiệu hoặc gian hàng" /></div>
        <div class="col-md-4 col-lg-3"><label class="form-label" for="CategoryId">Ngành hàng</label><select id="CategoryId" name="CategoryId" class="form-select"><option value="">Tất cả ngành hàng</option>@foreach (var item in Model.Categories) { <option value="@item.Value" selected="@(item.Value == Model.CategoryId?.ToString() ? "selected" : null)">@item.Text</option> }</select></div>
        <div class="col-md-4 col-lg-2"><label class="form-label" for="StoreId">Gian hàng</label><select id="StoreId" name="StoreId" class="form-select"><option value="">Tất cả gian hàng</option>@foreach (var item in Model.Stores) { <option value="@item.Value" selected="@(item.Value == Model.StoreId?.ToString() ? "selected" : null)">@item.Text</option> }</select></div>
        <div class="col-md-4 col-lg-2"><label class="form-label" for="Sort">Sắp xếp</label><select id="Sort" name="Sort" class="form-select"><option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Mới nhất</option><option value="price_asc" selected="@(Model.Sort == "price_asc" ? "selected" : null)">Giá tăng dần</option><option value="price_desc" selected="@(Model.Sort == "price_desc" ? "selected" : null)">Giá giảm dần</option><option value="rating_desc" selected="@(Model.Sort == "rating_desc" ? "selected" : null)">Đánh giá cao</option><option value="name_asc" selected="@(Model.Sort == "name_asc" ? "selected" : null)">Tên A–Z</option></select></div>
        <div class="col-md-3"><label class="form-label" for="Brand">Thương hiệu</label><select id="Brand" name="Brand" class="form-select"><option value="">Tất cả thương hiệu</option>@foreach (var item in Model.Brands) { <option value="@item.Value" selected="@(item.Value == Model.Brand ? "selected" : null)">@item.Text</option> }</select></div>
        <div class="col-6 col-md-2"><label class="form-label" for="MinPrice">Giá từ</label><input id="MinPrice" name="MinPrice" value="@Model.MinPrice" type="number" min="0" class="form-control" placeholder="0 đ" /></div>
        <div class="col-6 col-md-2"><label class="form-label" for="MaxPrice">Giá đến</label><input id="MaxPrice" name="MaxPrice" value="@Model.MaxPrice" type="number" min="0" class="form-control" placeholder="Không giới hạn" /></div>
        <div class="col-md-2"><label class="form-label" for="MinimumRating">Đánh giá</label><select id="MinimumRating" name="MinimumRating" class="form-select"><option value="">Tất cả</option>@for (var rating = 5; rating >= 1; rating--) { <option value="@rating" selected="@(Model.MinimumRating == rating ? "selected" : null)">Từ @rating sao</option> }</select></div>
        <div class="col-auto form-check filter-check"><input id="InStockOnly" name="InStockOnly" value="true" @(Model.InStockOnly ? "checked" : null) class="form-check-input" type="checkbox" /><label class="form-check-label" for="InStockOnly">Chỉ sản phẩm còn hàng</label></div>
        <div class="col-auto form-check filter-check"><input id="OnSaleOnly" name="OnSaleOnly" value="true" @(Model.OnSaleOnly ? "checked" : null) class="form-check-input" type="checkbox" /><label class="form-check-label" for="OnSaleOnly">Đang khuyến mãi</label></div>
        <div class="col-auto ms-md-auto"><button class="btn btn-primary px-4">Áp dụng</button> <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a></div>
    </div></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="card empty-market"><div class="card-body text-center py-5"><div class="display-5">🛒</div><h2 class="h4 mt-3">Chưa tìm thấy sản phẩm phù hợp</h2><p class="text-muted">Bạn thử bỏ bớt điều kiện lọc hoặc tìm bằng từ khóa khác nhé.</p><a asp-action="Index" class="btn btn-primary">Xem toàn bộ sản phẩm</a></div></div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
    @foreach (var item in Model.Items)
    {
        <div class="col"><article class="card product-card market-product h-100">
            <div class="product-image-wrap">
                @if (item.IsOnSale) { <span class="aisle-tag">GIẢM GIÁ</span> }
                @if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img src="@item.ImageUrl" alt="@(item.AltText ?? item.ProductName)" class="product-card-image" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" /><div class="product-image-placeholder" hidden>Không tải được ảnh</div> } else { <div class="product-image-placeholder">Chưa có ảnh</div> }
            </div>
            <div class="card-body d-flex flex-column"><small class="store-label">🏪 @item.StoreName</small><h2 class="h6">@item.ProductName</h2>@if (!string.IsNullOrWhiteSpace(item.Brand)) { <div class="small text-muted">@item.Brand</div> }<div class="rating-line">★ @item.AverageRating.ToString("0.0") <span>(@item.ReviewCount)</span> · <b class="@(item.IsInStock ? "in-stock" : "out-stock")">@(item.IsInStock ? "Còn hàng" : "Hết hàng")</b></div><div class="mt-auto">@if (item.IsOnSale) { <small class="old-price">@item.Price.ToString("N0") đ</small> }<div class="product-current-price">@item.CurrentPrice.ToString("N0") đ</div><a asp-action="CanonicalDetails" asp-route-productSlug="@item.Slug" class="btn btn-outline-primary w-100 mt-2">Xem sản phẩm</a></div></div>
        </article></div>
    }
    </div>
}

<nav class="catalog-pagination mt-4" aria-label="Phân trang"><span>Trang <strong>@Model.Page</strong> / @Model.TotalPages</span><div>@if (Model.Page > 1) { <a class="btn btn-outline-secondary" asp-route-page="@(Model.Page - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-storeId="@Model.StoreId" asp-route-brand="@Model.Brand" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-minimumRating="@Model.MinimumRating" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-sort="@Model.Sort">← Trang trước</a> } @if (Model.Page < Model.TotalPages) { <a class="btn btn-primary" asp-route-page="@(Model.Page + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-storeId="@Model.StoreId" asp-route-brand="@Model.Brand" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-minimumRating="@Model.MinimumRating" asp-route-inStockOnly="@Model.InStockOnly" asp-route-onSaleOnly="@Model.OnSaleOnly" asp-route-sort="@Model.Sort">Trang sau →</a> }</div></nav>
