@model ThuongMaiDienTu.ViewModels.ProductDetailsViewModel
@using System.Text.Json

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.SeoTitle)
        ? Model.ProductName
        : Model.SeoTitle;
    ViewData["Description"] = Model.SeoDescription ?? Model.ShortDescription ?? $"Khám phá {Model.ProductName}.";
    ViewData["CanonicalPath"] = $"/san-pham/{Model.Slug}";
    var structuredData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["name"] = Model.ProductName,
        ["description"] = Model.ShortDescription,
        ["image"] = string.IsNullOrWhiteSpace(Model.ImageUrl) ? null : new[] { Model.ImageUrl },
        ["sku"] = Model.SkuCode,
        ["brand"] = string.IsNullOrWhiteSpace(Model.Brand) ? null : new Dictionary<string, object?> { ["@type"] = "Brand", ["name"] = Model.Brand },
        ["offers"] = new Dictionary<string, object?> { ["@type"] = "Offer", ["priceCurrency"] = "VND", ["price"] = Model.CurrentPrice, ["availability"] = Model.IsInStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock", ["url"] = $"/san-pham/{Model.Slug}" },
        ["aggregateRating"] = Model.ReviewCount > 0 ? new Dictionary<string, object?> { ["@type"] = "AggregateRating", ["ratingValue"] = Model.AverageRating, ["reviewCount"] = Model.ReviewCount } : null
    };
    var breadcrumbData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org", ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang chủ", ["item"] = "/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = Model.CategoryName, ["item"] = $"/danh-muc/{Model.CategorySlug}" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Model.ProductName, ["item"] = $"/san-pham/{Model.Slug}" }
        }
    };
}

@section Meta {
    <meta property="og:type" content="product" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:url" content="/san-pham/@Model.Slug" />
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(structuredData))</script>
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(breadcrumbData))</script>
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item"><a asp-controller="Categories" asp-action="Details" asp-route-categorySlug="@Model.CategorySlug">@Model.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="product-detail-image-wrap border rounded bg-white">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@(Model.AltText ?? Model.ProductName)"
                     class="img-fluid product-detail-image"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="product-image-placeholder align-items-center justify-content-center text-muted"
                     style="display:none;">Không tải được ảnh</div>
            }
            else
            {
                <div class="product-image-placeholder d-flex align-items-center justify-content-center text-muted">
                    Chưa có ảnh
                </div>
            }
        </div>
        @if (Model.Images.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mt-2" aria-label="Thư viện ảnh sản phẩm">
                @foreach (var image in Model.Images)
                {
                    <button type="button"
                            class="btn btn-light border p-1 product-thumbnail @(image == Model.Images[0] ? "active border-primary" : null)"
                            data-image-url="@image.ImageUrl"
                            data-image-alt="@(image.AltText ?? Model.ProductName)">
                        <img src="@image.ImageUrl"
                             alt="@(image.AltText ?? Model.ProductName)"
                             width="72" height="72"
                             style="object-fit:cover"
                             onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                        <span class="small text-muted" hidden>Ảnh lỗi</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="col-lg-6">
        <span class="badge bg-light text-dark border mb-2">@Model.CategoryName</span>
        <h1 class="h2">@Model.ProductName</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Brand))
        {
            <p class="text-muted mb-2">Thương hiệu: <strong>@Model.Brand</strong></p>
        }

        <p>@Model.ShortDescription</p>

        <div class="border-top border-bottom py-3 my-3">
            <div id="regular-price-wrap" class="d-flex align-items-center gap-2 @(Model.IsOnSale ? null : "d-none")">
                <span id="regular-price" class="text-muted text-decoration-line-through fs-5">
                    @Model.Price.ToString("N0") đ
                </span>
                <span id="discount-badge" class="badge bg-danger">Giảm @Model.DiscountPercent%</span>
            </div>
            <div id="current-price" class="display-6 fw-bold @(Model.IsOnSale ? "text-danger" : null)">
                @Model.CurrentPrice.ToString("N0") đ
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-4">Mã SKU</dt>
            <dd class="col-sm-8"><code id="selected-sku-code">@Model.SkuCode</code></dd>
            <dt class="col-sm-4">Cửa hàng</dt>
            <dd class="col-sm-8">@Model.StoreName</dd>
            <dt class="col-sm-4">Tình trạng</dt>
            <dd class="col-sm-8">
                <span id="stock-badge" class="badge @(Model.IsInStock ? "bg-success" : "bg-secondary")">
                    @(Model.IsInStock ? "Còn hàng" : "Hết hàng")
                </span>
                <span id="stock-quantity" class="ms-1">
                    @(Model.IsInStock ? $"{Model.StockQuantity} sản phẩm" : "SKU này đã hết hàng")
                </span>
            </dd>
        </dl>

        @if (Model.Skus.Count > 1)
        {
            <div class="mb-3">
                <label for="sku-selector" class="form-label fw-semibold">Chọn biến thể</label>
                <select id="sku-selector" class="form-select">
                    @foreach (var variant in Model.Skus)
                    {
                        <option value="@variant.SkuId"
                                data-stock="@variant.StockQuantity"
                                data-code="@variant.SkuCode"
                                data-regular-price="@variant.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-price="@variant.CurrentPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-sale="@variant.IsOnSale.ToString().ToLowerInvariant()"
                                selected="@(variant.SkuId == Model.SkuId ? "selected" : null)">
                            @variant.SkuCode — @variant.CurrentPrice.ToString("N0") đ
                            (@(variant.StockQuantity > 0 ? $"còn {variant.StockQuantity}" : "hết hàng"))
                        </option>
                    }
                </select>
            </div>
        }

        @if (User.IsInRole("CUSTOMER"))
        {
            @if (Model.IsInStock)
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input id="selected-sku-id" type="hidden" name="SkuId" value="@Model.SkuId" />
                    <div class="input-group">
                        <span class="input-group-text">Số lượng</span>
                        <input id="purchase-quantity" type="number" name="Quantity" value="1"
                               min="1" max="@Model.StockQuantity"
                               class="form-control"
                               aria-label="Số lượng mua" />
                        <button id="add-to-cart-button" type="submit" class="btn btn-primary">Thêm vào giỏ</button>
                    </div>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-secondary w-100" disabled>
                    Sản phẩm đã hết hàng
                </button>
            }
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
               class="btn btn-primary w-100">Đăng nhập để mua</a>
        }
    </div>
</div>

<section class="card mt-4">
    <div class="card-header fw-semibold">Mô tả sản phẩm</div>
    <div class="card-body">
        <p class="mb-0" style="white-space: pre-line;">
            @(Model.Description ?? Model.ShortDescription ?? "Thông tin sản phẩm đang được cập nhật.")
        </p>
    </div>
</section>

<section class="mt-4">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h4 mb-0">Đánh giá sản phẩm</h2>
        @if (Model.ReviewCount > 0)
        {
            <span class="badge bg-warning text-dark">
                @Model.AverageRating.ToString("0.0")/5 · @Model.ReviewCount đánh giá
            </span>
        }
    </div>
    @if (Model.Reviews.Count == 0)
    {
        <div class="alert alert-light border">Sản phẩm chưa có đánh giá được hiển thị.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var review in Model.Reviews)
            {
                <div class="col-md-6">
                    <article class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-2">
                                <strong>@review.CustomerName</strong>
                                <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <div class="text-warning" aria-label="@review.Rating trên 5 sao">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <span>@(star <= review.Rating ? "★" : "☆")</span>
                                }
                            </div>
                            <p class="mb-0 mt-2">@(review.Comment ?? "Không có nội dung bình luận.")</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

<a asp-action="Index" class="btn btn-outline-secondary mt-4">Quay lại danh sách</a>

@section Scripts {
    <script>
        document.querySelectorAll(".product-thumbnail").forEach(button => {
            button.addEventListener("click", () => {
                document.querySelectorAll(".product-thumbnail").forEach(item =>
                    item.classList.remove("active", "border-primary"));
                button.classList.add("active", "border-primary");
                const image = document.querySelector(".product-detail-image");
                if (image) {
                    image.src = button.dataset.imageUrl;
                    image.alt = button.dataset.imageAlt;
                }
            });
        });

        const skuSelector = document.getElementById("sku-selector");
        const selectedSku = document.getElementById("selected-sku-id");
        if (skuSelector && selectedSku) {
            const synchronizeVariant = () => {
                const option = skuSelector.selectedOptions[0];
                const stock = Number(option.dataset.stock);
                const price = Number(option.dataset.price);
                const regularPrice = Number(option.dataset.regularPrice);
                selectedSku.value = option.value;
                document.getElementById("selected-sku-code").textContent = option.dataset.code;
                document.getElementById("current-price").textContent =
                    price.toLocaleString("vi-VN") + " đ";
                const stockQuantity = document.getElementById("stock-quantity");
                const stockBadge = document.getElementById("stock-badge");
                if (stockQuantity) stockQuantity.textContent =
                    stock > 0 ? `${stock} sản phẩm` : "SKU này đã hết hàng";
                if (stockBadge) {
                    stockBadge.textContent = stock > 0 ? "Còn hàng" : "Hết hàng";
                    stockBadge.className = `badge ${stock > 0 ? "bg-success" : "bg-secondary"}`;
                }
                const quantity = document.getElementById("purchase-quantity");
                const button = document.getElementById("add-to-cart-button");
                if (quantity) {
                    quantity.max = stock;
                    quantity.disabled = stock <= 0;
                    if (Number(quantity.value) > stock) quantity.value = Math.max(1, stock);
                }
                if (button) button.disabled = stock <= 0;
                const sale = option.dataset.sale === "true";
                document.getElementById("current-price").classList.toggle("text-danger", sale);
                document.getElementById("regular-price").textContent =
                    regularPrice.toLocaleString("vi-VN") + " đ";
                document.getElementById("regular-price-wrap").classList.toggle("d-none", !sale);
                const discount = regularPrice > 0
                    ? Math.round((regularPrice - price) * 100 / regularPrice)
                    : 0;
                document.getElementById("discount-badge").textContent = `Giảm ${discount}%`;
            };
            skuSelector.addEventListener("change", synchronizeVariant);
            synchronizeVariant();
        }
    </script>
}
