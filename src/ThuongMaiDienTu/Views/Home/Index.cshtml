@model ThuongMaiDienTu.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Siêu thị nội thất và gia dụng";
    ViewData["Description"] = "Mua sắm nội thất và đồ gia dụng từ nhiều gian hàng uy tín, giá tốt mỗi ngày.";
}

<section class="market-hero mb-4">
    <div class="market-hero-content">
        <span class="market-eyebrow">TUẦN LỄ NHÀ ĐẸP</span>
        <h1>Mua đủ đồ cho nhà,<br /><span>giá tốt khỏi đi xa.</span></h1>
        <p>Khám phá hàng trăm sản phẩm nội thất và gia dụng từ các gian hàng uy tín, giao tận cửa nhà.</p>
        <form asp-controller="Products" asp-action="Index" method="get" class="market-search">
            <input name="searchTerm" class="form-control" placeholder="Hôm nay bạn muốn mua gì?" />
            <button class="btn btn-warning">Tìm ngay</button>
        </form>
        <div class="hero-benefits"><span>✓ Giá minh bạch</span><span>✓ Nhiều gian hàng</span><span>✓ Giao hàng tiện lợi</span></div>
    </div>
    <div class="market-hero-deal" aria-label="Ưu đãi nổi bật">
        <span>ƯU ĐÃI</span><strong>ĐẾN 30%</strong><small>Săn deal nhà đẹp hôm nay</small>
    </div>
</section>

<section class="market-section category-zone mb-4">
    <div class="section-heading"><div><span class="section-kicker">MUA NHANH</span><h2>Ngành hàng nổi bật</h2></div><a asp-controller="Products" asp-action="Index">Xem tất cả →</a></div>
    <nav class="market-categories" aria-label="Danh mục nổi bật">
        @foreach (var category in Model.Categories)
        {
            <a asp-controller="Categories" asp-action="Details" asp-route-categorySlug="@category.Slug" class="market-category">
                <span class="category-icon">@(category.CategoryName.Contains("Ghế", StringComparison.OrdinalIgnoreCase) ? "🪑" : category.CategoryName.Contains("Bàn", StringComparison.OrdinalIgnoreCase) ? "🛋️" : category.CategoryName.Contains("Giường", StringComparison.OrdinalIgnoreCase) ? "🛏️" : category.CategoryName.Contains("Tủ", StringComparison.OrdinalIgnoreCase) ? "🗄️" : "🏠")</span>
                <strong>@category.CategoryName</strong><small>Khám phá ngay</small>
            </a>
        }
    </nav>
</section>

<section class="market-section deal-zone mb-4">
    <div class="section-heading"><div><span class="section-kicker hot">GIÁ TỐT HÔM NAY</span><h2>Sản phẩm mới về</h2></div><div class="deal-clock">Kết thúc sau <strong>08 : 24 : 16</strong></div></div>
    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
        @foreach (var product in Model.NewProducts)
        {
            <div class="col">
                <article class="card product-card market-product h-100">
                    <div class="product-image-wrap">
                        <span class="aisle-tag">MỚI</span>
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.ProductName" class="product-card-image" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                            <div class="product-image-placeholder" hidden>Không tải được ảnh</div>
                        }
                        else { <div class="product-image-placeholder">Chưa có ảnh</div> }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <small class="store-label">🏪 @product.StoreName</small>
                        <h3>@product.ProductName</h3>
                        <div class="mt-auto">
                            @if (product.IsOnSale) { <small class="old-price">@product.Price.ToString("N0") đ</small> }
                            <div class="product-current-price">@product.CurrentPrice.ToString("N0") đ</div>
                            <span class="stock-note">● Còn hàng</span>
                        </div>
                    </div>
                    <a asp-controller="Products" asp-action="CanonicalDetails" asp-route-productSlug="@product.Slug" class="stretched-link"><span class="visually-hidden">Xem @product.ProductName</span></a>
                </article>
            </div>
        }
    </div>
</section>

<section class="promo-aisles mb-4">
    <article class="promo-card promo-yellow"><span>PHÒNG KHÁCH</span><h2>Nâng cấp góc thư giãn</h2><p>Sofa, bàn trà và kệ trang trí cho không gian thêm ấm cúng.</p><a asp-controller="Products" asp-action="Index">Mua ngay →</a></article>
    <article class="promo-card promo-green"><span>GÓC BẾP</span><h2>Gọn bếp, vui nhà</h2><p>Tủ kệ và đồ dùng thiết yếu giúp việc bếp núc nhẹ nhàng hơn.</p><a asp-controller="Products" asp-action="Index">Khám phá →</a></article>
</section>

<section class="market-section mb-4">
    <div class="section-heading"><div><span class="section-kicker">GIAN HÀNG UY TÍN</span><h2>Thương hiệu trong siêu thị</h2></div></div>
    <div class="store-strip">
        @foreach (var store in Model.FeaturedStores)
        {
            <a asp-controller="Stores" asp-action="Details" asp-route-storeSlug="@store.Slug" class="store-tile"><span>🏬</span><div><strong>@store.StoreName</strong><small>@store.ProductCount sản phẩm đang bán</small></div><b>›</b></a>
        }
    </div>
</section>

<section class="service-strip">
    <div><span>🚚</span><strong>Giao hàng linh hoạt</strong><small>Chọn dịch vụ phù hợp</small></div>
    <div><span>🛡️</span><strong>Mua sắm an tâm</strong><small>Thông tin rõ ràng</small></div>
    <div><span>🏪</span><strong>Đa gian hàng</strong><small>Một giỏ, nhiều lựa chọn</small></div>
    <div><span>💬</span><strong>Hỗ trợ nhanh</strong><small>Trợ lý mua sắm 24/7</small></div>
</section>
